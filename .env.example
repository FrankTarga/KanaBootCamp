# Copie para .env (o .env não vai para o Git) e troque a chave.
# Chave que o gestor digita na gaveta para salvar regras (PUT /api/v1/validators)
ADMIN_API_KEY=troque-esta-chave

# Fonte da situação cadastral do sacado (o mock da Receita usa esta):
#   gabarito  = 87 CNPJs irregulares do resultado_esperado_100k.json (padrão; bate 100% com o gabarito)
#   kanastra  = cnpj_situacao_mock.csv publicado pela organização (CNPJ ausente = ATIVA)
#   formato   = sem restrição; só vale a checagem do CNPJ (14 dígitos + dígito verificador)
SITUACAO_FONTE=gabarito
